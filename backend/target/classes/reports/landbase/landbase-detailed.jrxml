            <!-- ===== ROW 3: PERMANENT HOME ADDRESS | PASSPORT NUMBER | SEAMAN'S BOOK NUMBER ===== -->
            <rectangle>
                <reportElement mode="Transparent" x="0" y="42" width="555" height="24"/>
