            </textField>

            <!-- ===== SECTION II: PHYSICAL EXAMINATION ===== -->
            <line><reportElement x="0" y="180" width="555" height="1"/></line>
            <staticText>
                <reportElement x="0" y="182" width="555" height="12"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[II.  PHYSICAL EXAMINATION - Check the appropriate box. Under columns A, B, C check if normal; uncheck if not normal and specify findings.]]></text>
            </staticText>
            <!-- Vital Signs Row -->
            <staticText>
                <reportElement x="0" y="196" width="50" height="10"/>
                <textElement><font size="6"/></textElement>
