    <title>
        <band height="105">
            <!-- Logo on the left -->
            <image>
                <reportElement x="0" y="0" width="65" height="60"/>
                <imageExpression><![CDATA["reports/centerport-logo.png"]]></imageExpression>
            </image>
            <!-- Company name and address centered in green -->
            <staticText>
                <reportElement x="70" y="0" width="380" height="16" forecolor="#006400"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[CENTERPORT MEDICAL SERVICES, INC.]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="15" width="380" height="10" forecolor="#006400"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[4/F Victoria Building, 429 United Nations Avenue,]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="24" width="380" height="10" forecolor="#006400"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Cor. L.M. Guerrero St., Ermita Manila, Philippines]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="33" width="380" height="10" forecolor="#006400"/>
                <textElement textAlignment="Center">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Tel. No. 5260221, Fax No. 5281578, Email Add. centerportmed@yahoo.com]]></text>
            </staticText>
            <!-- Photo on the right -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="470" y="0" width="85" height="85"/>
                <imageExpression><![CDATA[$P{photoUrl}]]></imageExpression>
            </image>
            <!-- DOH Accreditation and Medical Certificate -->
            <staticText>
                <reportElement x="100" y="48" width="120" height="12" forecolor="#006400"/>
                <textElement><font size="7" isBold="true" isItalic="true"/></textElement>
                <text><![CDATA[DOH Accreditation No.]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="220" y="48" width="80" height="12" forecolor="#006400"/>
                <textElement><font size="7" isBold="true" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{dohAccreditationNo}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="310" y="48" width="100" height="12" forecolor="#006400"/>
                <textElement><font size="7" isBold="true" isItalic="true"/></textElement>
                <text><![CDATA[Medical Certificate No.]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="410" y="48" width="50" height="12" forecolor="#006400"/>
                <textElement><font size="7" isBold="true" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{medicalCertificationNo}]]></textFieldExpression>
            </textField>
            <!-- Ref No on the right -->
            <staticText>
                <reportElement x="460" y="88" width="40" height="10"/>
                <textElement textAlignment="Right"><font size="6"/></textElement>
                <text><![CDATA[Ref. No.]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="502" y="88" width="53" height="10"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{refNo}]]></textFieldExpression>
            </textField>
            <!-- Title: MEDICAL EXAMINATION REPORT -->
            <staticText>
                <reportElement x="0" y="64" width="460" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[MEDICAL EXAMINATION REPORT]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="618">
            <!-- ===== ROW 1: SURNAME | FIRST NAME | MIDDLE NAME ===== -->
            <rectangle>
                <reportElement mode="Transparent" x="0" y="0" width="555" height="17"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="4" width="44" height="10"/>
                <textElement verticalAlignment="Middle"><font size="6.5"/></textElement>
                <text><![CDATA[SURNAME:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="48" y="2" width="164" height="13"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{lastName}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="216" y="0" width="1" height="17"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="220" y="4" width="48" height="10"/>
