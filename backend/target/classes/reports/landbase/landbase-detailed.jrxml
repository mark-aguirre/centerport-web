                <textFieldExpression><![CDATA[$P{civilStatus}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="306" y="17" width="1" height="25"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="310" y="19" width="55" height="9"/>
                <textElement><font size="5.5"/></textElement>
                <text><![CDATA[RELIGION:]]></text>
