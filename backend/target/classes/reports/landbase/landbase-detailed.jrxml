            <!-- ===== ROW 4: NAME OF EMPLOYER | COUNTRY OF DESTINATION | CONTACT NUMBER | POSITION APPLIED FOR ===== -->
            <rectangle>
                <reportElement mode="Transparent" x="0" y="66" width="555" height="24"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="68" width="100" height="9"/>
                <textElement><font size="5.5"/></textElement>
