            <!-- ===== SECTION I: PAST MEDICAL HISTORY ===== -->
            <staticText>
                <reportElement x="0" y="94" width="555" height="12"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[I.  PAST MEDICAL HISTORY.    Has applicant suffered from or been told he has any of the following: Check the appropriate box.]]></text>
            </staticText>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="115" width="555" height="40"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{medicalHistory}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="157" width="300" height="10"/>
                <textElement><font size="6"/></textElement>
                <text><![CDATA[Have you consulted any doctor about a disease in the past? Check if Yes]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="300" y="157" width="50" height="10"/>
