                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{middleName}]]></textFieldExpression>
            </textField>

            <!-- ===== ROW 2: PLACE/DATE OF BIRTH | AGE | SEX | CIVIL STATUS | RELIGION | NATIONALITY ===== -->
            <rectangle>
                <reportElement mode="Transparent" x="0" y="17" width="555" height="25"/>
